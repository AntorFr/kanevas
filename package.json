{
  "name": "kanevas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/ && vite build --config frontend/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "test": "node --import tsx --test $(find src frontend/src -name '*.test.ts')",
    "dev:front": "vite --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cookie": "^11.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "lucide-react": "1.52.0",
    "openid-client": "^6.8.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.2"
  }
}
