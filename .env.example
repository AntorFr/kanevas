# La version n'est jamais lue ici ni dans package.json : en local sans
# Docker, elle vaut le défaut "0.0.0-dev" (src/config/env.ts) ; en image, elle
# vient exclusivement du build-arg Docker APP_VERSION (Dockerfile, CI).
PORT=3001
NODE_ENV=development

# SSO OIDC (Authelia) — optionnel : les 4 variables vont ensemble.
# Absentes -> /api/auth/oidc/* répond 404 (pas de mode dégradé).
#OIDC_ISSUER=https://auth.berard.me
#OIDC_CLIENT_ID=kanevas
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://kanevas.tantive.berard.me/api/auth/oidc/callback

# Mode bouchon (AD-55) : choix d'un compte de test au lieu d'Authelia. Refus de démarrer si une
# variable OIDC_* est posée.
#KANEVAS_STUB=1
# Secret de session (>= 16 caractères) ; à défaut, session.key à côté de la base.
#SESSION_SECRET=
# Fichier SQLite ; défaut ./data/kanevas.db (dev), /data/kanevas.db (production).
#DB_PATH=

# Transports LLM repris d'Antre-du-maitre (AD-10) : aucune route
# ne les appelle encore.
# LLM_PROVIDER : mock | anthropic | claude-agent
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-6
#LLM_PROVIDER=mock
