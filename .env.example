# The version is never read here nor from package.json: locally without
# Docker it defaults to "0.0.0-dev" (src/config/env.ts); in the image it comes
# exclusively from the APP_VERSION Docker build-arg (Dockerfile, CI).
PORT=3001
NODE_ENV=development

# OIDC SSO (Authelia) — optional: the 4 variables go together.
# Absent -> /api/auth/oidc/* answers 404 (no degraded mode).
#OIDC_ISSUER=https://auth.berard.me
#OIDC_CLIENT_ID=kanevas
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://kanevas.tantive.berard.me/api/auth/oidc/callback

# Stub mode (AD-55): pick a test account instead of Authelia. Refuses to start if any OIDC_*
# variable is set.
#KANEVAS_STUB=1
# Session secret (>= 16 characters); absent, session.key next to the database.
#SESSION_SECRET=
# SQLite file; default ./data/kanevas.db (dev), /data/kanevas.db (production).
#DB_PATH=

# LLM transports reprised from Antre-du-maitre (AD-10): no route of this
# socle calls them yet (out of scope).
# LLM_PROVIDER : mock | anthropic | claude-agent
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-6
#LLM_PROVIDER=mock

# Assistant (AD-54, AD-77): token of the Claude subscription (`claude setup-token`). Empty = the
# assistant is unavailable (except with KANEVAS_STUB=1, where the script stub answers). The model is
# ANTHROPIC_MODEL.
CLAUDE_CODE_OAUTH_TOKEN=

# ATTACHMENTS_DIR overrides where attachments and illustrations are stored (any mode).
#ATTACHMENTS_DIR=
# Stub mode only: KANEVAS_SANS_SEMIS=1 skips the demonstration world seeded at startup.
#KANEVAS_SANS_SEMIS=
